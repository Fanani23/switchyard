# API
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://starter:starter@localhost:5432/starter
REDIS_URL=redis://localhost:6379
DB_POOL_MAX=10

# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Rate limiting (per API key) and request size cap, as in SPEC.md's limits table.
RATE_LIMIT_MAX=100
RULESET_RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=1 minute
BODY_LIMIT=262144

# Bootstrap key for creating projects and environments (min 32 chars). Leave empty to
# disable. Generate with: openssl rand -base64 32
SWITCHYARD_ROOT_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
