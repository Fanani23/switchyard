# Normalize to LF in the repository. Without this, files committed from Windows carry CRLF
# and the CI step that regenerates openapi.json and diffs it would always fail on Linux.
* text=auto eol=lf

# Binary and generated files git must not touch.
pnpm-lock.yaml linguist-generated=true
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
