# Copy to .env on the server, fill in, then chmod 600. Never commit the real file.
POSTGRES_USER=switchyard
POSTGRES_PASSWORD=
POSTGRES_DB=switchyard

# Reaches the database over the container network, not the published host port.
DATABASE_URL=postgres://switchyard:<password>@postgres:5432/switchyard

# At least 32 characters. Generate with: openssl rand -hex 32
SWITCHYARD_ROOT_KEY=

PUBLIC_ORIGIN=https://switchyard.nexorahq.my.id
